[Unit]
Description=UFC live fight card on the 64x32 LED panel
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/pi/ufc-led-scoreboard
ExecStart=/usr/bin/python3 -u /home/pi/ufc-led-scoreboard/scoreboard.py --driver matrix --lower-portraits --brightness 20 --gpio-slowdown 2
Restart=on-failure
RestartSec=8
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
